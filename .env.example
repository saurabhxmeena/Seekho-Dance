# ==========================================
# 1. Supabase Authentication & Database
# ==========================================
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ==========================================
# 2. Razorpay API Credentials
# ==========================================
# Get these from: https://dashboard.razorpay.com/app/keys
# Test mode keys start with: rzp_test_
# Live mode keys start with: rzp_live_

# Public Razorpay Key ID (Safe to expose to browser)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Razorpay Key Secret (CRITICAL: KEEP STRICTLY ON SERVER, NEVER EXPOSE TO CLIENT)
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Optional: Razorpay.me personal handle / direct payment link
NEXT_PUBLIC_RAZORPAY_ME_URL=https://razorpay.me/@seekhodance
